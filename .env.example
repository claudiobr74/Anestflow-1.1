# Google OAuth is configured in the Supabase Dashboard / CLI env, not in the browser bundle.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
