rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDocOpen(data) {
      return data == null || !('status' in data) || (data.status != 'Signed' && data.status != 'Encerrado' && data.isSigned != true);
    }

    function isParticipant(data) {
      return isSignedIn() && (
        data == null ||
        data.get('createdByUid', '') == request.auth.uid ||
        data.get('currentResponsibleUid', '') == request.auth.uid ||
        data.get('userId', '') == request.auth.uid ||
        ('participantUids' in data && data.participantUids != null && request.auth.uid in data.participantUids) ||
        ('sharedWithEmails' in data && data.sharedWithEmails != null && request.auth.token.email in data.sharedWithEmails)
      );
    }

    match /users/{uid} {
      allow read: if isSignedIn(); // Allow logged in doctors to search profiles by email
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /procedures/{procedureId} {
      allow read: if isSignedIn() && (
        !exists(/databases/$(database)/documents/procedures/$(procedureId)) ||
        isParticipant(resource.data)
      );

      allow create: if isSignedIn();

      allow update: if isSignedIn() && (
        isParticipant(resource.data) ||
        isParticipant(request.resource.data)
      );

      allow delete: if isSignedIn() && (
        resource.data == null ||
        resource.data.get('createdByUid', resource.data.get('userId', '')) == request.auth.uid
      );

      match /amendments/{amendmentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.procedureId == procedureId
          && request.resource.data.createdByUid == request.auth.uid;
        allow update: if false; // Adendo criado NUNCA pode ser alterado
        allow delete: if false; // Adendo criado NUNCA pode ser excluído
      }

      match /vitals/{vitalId} {
        allow read, write: if isSignedIn();
      }

      match /medications/{medicationId} {
        allow read, write: if isSignedIn();
      }

      match /fluids/{fluidId} {
        allow read, write: if isSignedIn();
      }

      match /infusions/{infusionId} {
        allow read, write: if isSignedIn();
      }

      match /clinicalEvents/{eventId} {
        allow read, write: if isSignedIn();
      }

      match /transfers/{transferId} {
        allow read, write: if isSignedIn();
      }
    }

    match /worklist/{cpf} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && cpf.matches('^[0-9]{11}$');
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

